{
  // Deploy configuration lives in the repository rather than only in the
  // dashboard, so a build is reproducible from a checkout and a change to it
  // arrives as a reviewable diff.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cqx-web",
  "compatibility_date": "2026-09-18",

  // One server, for one thing. Three calls to GitHub are metered and the rest
  // of the traffic is not: file contents go from the CDN straight to the
  // browser and never pass through here. Everything under /gh/ is those three,
  // answered from the bucket where it can be; everything else is the site.
  "main": "worker/index.ts",

  // Addresses are paths — /dekaruntime/deka/7e8321c7/packages/deka_http — and
  // none of them is a file on disk, so anything that does not match an asset is
  // served the page and routed there.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",

    // Without this the worker never runs. Assets are served first, and a
    // single-page fallback means every path matches an asset — so /gh/ was
    // answered with the page, and the three routes that exist to save requests
    // quietly returned HTML.
    "run_worker_first": ["/gh/*"]
  },

  // The same bucket the datasets live in, so what is learned about a
  // repository sits beside what was measured of it.
  "r2_buckets": [
    { "binding": "CACHE", "bucket_name": "cqx" }
  ],

  "observability": {
    "enabled": true
  }
}
