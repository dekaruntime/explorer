# Cloudflare Pages reads this file. Asset names carry a content hash, so they can
# be cached forever; a dataset keeps the same name when it is re-analysed, so it
# cannot.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=300, must-revalidate

/*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm
